# Copiá este archivo como .env y completá los valores.

# InfluxDB
INFLUX_URL=http://localhost:8086
INFLUX_TOKEN=
INFLUX_ORG=planta
INFLUX_BUCKET=industrial

# InfluxDB (setup inicial del contenedor)
INFLUX_ADMIN_USER=admin
INFLUX_ADMIN_PASSWORD=

# MQTT
MQTT_HOST=localhost
MQTT_PORT=1883
MQTT_BASE_TOPIC=planta/maquina1

# OPC-UA
OPCUA_URL=opc.tcp://localhost:4840/freeopcua/server/

# Grafana
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=